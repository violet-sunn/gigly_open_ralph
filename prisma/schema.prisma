// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                              String             @id @default(cuid())
  email                           String             @unique
  password                        String
  role                            String             @default("USER")
  suspended                       Boolean            @default(false)
  hasCreatedFirstGig              Boolean            @default(false)
  hasSubmittedFirstApplication    Boolean            @default(false)
  gigCreationGuidanceDismissed    Boolean            @default(false)
  applicationGuidanceDismissed    Boolean            @default(false)
  locale                          String             @default("ru")
  notifyApplications              Boolean            @default(true)
  notifyStatusChanges             Boolean            @default(true)
  notifyMessages                  Boolean            @default(true)
  notifyPayments                  Boolean            @default(true)
  showRatingInProfile             Boolean            @default(true)
  showOnlineStatus                Boolean            @default(true)
  // transport-settings — Платежные данные currency + the two extra Email-уведомления rows (platform news / new gigs).
  currency                        String             @default("rub")
  notifyPlatformNews              Boolean            @default(true)
  notifyNewGigs                   Boolean            @default(true)
  // profile-experience-fixes — real online indicator. Touched by the lightweight `heartbeat` action
  // (~1/min from the shell); getProfile reads it (online = showOnlineStatus && within ONLINE_WINDOW).
  // Nullable/no default → additive & backward-compatible (existing rows read null ⇒ offline).
  lastSeenAt                      DateTime?
  createdAt                       DateTime           @default(now())
  updatedAt                       DateTime           @updatedAt
  gigs                            Gig[]              @relation("ClientGigs")
  applications                    Application[]
  assignedGigs                    Gig[]              @relation("AssignedGigs")
  clientProfile                   ClientProfile?
  specialistProfile               SpecialistProfile?
  adminActions                    ModerationLog[]    @relation("AdminActions")
  moderations                     ModerationLog[]    @relation("UserModerations")
  sentMessages                    Message[]          @relation("SentMessages")
  notifications                   Notification[]
  reviewsAuthored                 Review[]           @relation("ReviewsAuthored")
  reviewsReceived                 Review[]           @relation("ReviewsReceived")
  favoriteCategories              Category[]         @relation("FavoriteCategories")
  disputesOpened                  Dispute[]          @relation("DisputesOpened")
  disputesResolved                Dispute[]          @relation("DisputesResolved")
  sessions                        Session[]

  @@index([suspended])
}

/// Active login sessions (reconcile-settings) — one row per createSession; the JWT carries the row id as `sid`.
/// Powers the «Активные сессии» settings list (device from userAgent, current = the JWT's sid). No geo/location.
model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent    String   @default("")
  ipAddress    String   @default("")
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  @@index([userId])
}

model Gig {
  id                   String          @id @default(cuid())
  title                String
  description          String
  acceptanceCriteria   String?
  goal                 String          @default("")
  deliverables         String          @default("")
  constraints          String          @default("")
  budget               Int
  serviceFee           Int
  totalAmount          Int
  status               String          @default("OPEN")
  tags                 String          @default("")
  deadlineDays         Int             @default(0)
  stageCount           Int             @default(1)
  clientId             String
  client               User            @relation("ClientGigs", fields: [clientId], references: [id])
  assignedSpecialistId String?
  assignedSpecialist   User?           @relation("AssignedGigs", fields: [assignedSpecialistId], references: [id])
  paidAt               DateTime?
  closedByAdmin        Boolean         @default(false)
  closedAt             DateTime?
  isExample            Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  applications         Application[]
  moderations          ModerationLog[] @relation("GigModerations")
  messages             Message[]
  notifications        Notification[]
  reviews              Review[]
  disputes             Dispute[]
  categorySlug         String?
  category             Category?       @relation(fields: [categorySlug], references: [slug])

  @@index([closedByAdmin])
}

model Application {
  id              String   @id @default(cuid())
  gigId           String
  gig             Gig      @relation(fields: [gigId], references: [id])
  specialistId    String
  specialist      User     @relation(fields: [specialistId], references: [id])
  coverLetter     String   @default("")
  approach        String   @default("")
  questions       String   @default("")
  estimatedEffort String   @default("")
  proposedBudget       Int? // kopecks; null = no counter (gig.budget stands) — TermsTabs "Предложено"
  proposedDeadlineDays Int? // null = no counter (gig.deadlineDays stands)
  status          String   @default("PENDING") // PENDING | ACCEPTED | REJECTED | WITHDRAWN (reversible) | WITHDRAWN_FINAL (permanent)
  // One-free-withdrawal rule (fix-application-lifecycle): true once the specialist has used their single
  // reversible withdrawal on this gig. Server-authoritative, per-row (unique gigId+specialistId) — the next
  // withdrawal after this is set becomes WITHDRAWN_FINAL and blocks re-application.
  freeWithdrawalUsed Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([gigId, specialistId])
}

model ClientProfile {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName   String
  inn           String   @default("")
  kpp           String   @default("")
  about         String   @default("")
  contactPerson String   @default("")
  position      String   @default("")
  phoneNumber   String   @default("")
  location      String   @default("")
  timezone      String   @default("")
  avatarUrl     String   @default("")
  phoneVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SpecialistProfile {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String   @default("")
  techStack       String   @default("")
  experienceLevel String   @default("")
  bio             String   @default("")
  avatarUrl       String   @default("")
  phoneNumber     String   @default("")
  phoneVerified   Boolean  @default(false)
  position        String   @default("")
  specialization  String   @default("")
  location        String   @default("")
  timezone        String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workExperience  WorkExperience[]
}

model WorkExperience {
  id          String            @id @default(cuid())
  profileId   String
  profile     SpecialistProfile @relation(fields: [profileId], references: [userId], onDelete: Cascade)
  company     String
  title       String            @default("")
  description String            @default("")
  startYear   Int?
  endYear     Int? // null = "по настоящее время" (current)
  order       Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([profileId])
}

model ModerationLog {
  id           String   @id @default(cuid())
  action       String
  reason       String
  adminId      String
  admin        User     @relation("AdminActions", fields: [adminId], references: [id])
  targetUserId String?
  targetUser   User?    @relation("UserModerations", fields: [targetUserId], references: [id])
  targetGigId  String?
  targetGig    Gig?     @relation("GigModerations", fields: [targetGigId], references: [id])
  createdAt    DateTime @default(now())
  resolvedDispute Dispute?

  @@index([adminId])
  @@index([targetUserId])
  @@index([targetGigId])
  @@index([createdAt])
}

model Dispute {
  id              String         @id @default(cuid())
  gigId           String
  gig             Gig            @relation(fields: [gigId], references: [id])
  openerId        String
  opener          User           @relation("DisputesOpened", fields: [openerId], references: [id])
  openerRole      String         @default("") // "specialist" | "company" — set at creation (DATA-MODEL)
  amount          Int            @default(0) // gig budget frozen at open (kopecks)
  reason          String // one of the 6 DATA-MODEL DisputeReason values (validated in the action)
  evidence        String         @default("") // CSV/JSON of file names (SQLite has no array); names only, no upload backend
  status          String         @default("OPEN") // OPEN | RESOLVED | REJECTED
  resolution      String         @default("") // moderator verdict: specialist | company | split_50 + note
  resolvedById    String?
  resolvedBy      User?          @relation("DisputesResolved", fields: [resolvedById], references: [id])
  resolutionLogId String?        @unique
  resolutionLog   ModerationLog? @relation(fields: [resolutionLogId], references: [id])
  timeline        DisputeEntry[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([gigId, openerId])
  @@index([status])
  @@index([gigId])
}

model DisputeEntry {
  id         String   @id @default(cuid())
  disputeId  String
  dispute    Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  authorRole String // "specialist" | "company" | "moderator"
  authorName String   @default("")
  text       String
  createdAt  DateTime @default(now())

  @@index([disputeId])
}

model Message {
  id        String   @id @default(cuid())
  gigId     String
  gig       Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)
  senderId  String?
  sender    User?    @relation("SentMessages", fields: [senderId], references: [id])
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gigId])
  @@index([createdAt])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gigId      String
  gig        Gig       @relation(fields: [gigId], references: [id], onDelete: Cascade)
  type       String    @default("MESSAGE") // MESSAGE | APPLICATION | STATUS_CHANGE | PAYMENT (DATA-MODEL)
  eventType  String?
  eventData  String?
  text       String? // optional denormalized display text (derived text in notification-utils stays primary)
  lastReadAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, gigId])
  @@index([userId])
  @@index([gigId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String   @default("")
  gigId     String
  gig       Gig      @relation(fields: [gigId], references: [id])
  authorId  String
  author    User     @relation("ReviewsAuthored", fields: [authorId], references: [id])
  targetId  String
  target    User     @relation("ReviewsReceived", fields: [targetId], references: [id])
  createdAt DateTime @default(now())

  @@unique([gigId, authorId])
  @@index([targetId])
  @@index([gigId])
}

model Category {
  slug        String @id
  name        String
  order       Int    @default(0)
  color       String @default("blue") // design hue: blue|rose|green|teal|orange (DATA-MODEL §Category)
  gigs        Gig[]
  favoritedBy User[] @relation("FavoriteCategories")
}
