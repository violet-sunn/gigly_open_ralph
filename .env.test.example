# ============================================
# TEST ENVIRONMENT CONFIGURATION
# ============================================
#
# This file contains environment variables for the TEST environment.
# Used by: Vitest unit tests and Playwright E2E tests
#
# Setup Instructions:
# 1. Copy this file to .env.test: cp .env.test.example .env.test
# 2. The default values below are functional for tests - no changes needed
# 3. Tests use mocked rate limiting - real Upstash credentials NOT required
#
# Test-Specific Behavior:
# - Tests mock rate limiting via __tests__/helpers/ratelimit-mocks.ts
# - Test database (test.db) is separate from dev database (dev.db)
# - Test database is automatically cleaned between test runs
# - All placeholder values below are sufficient for test execution
#
# ============================================


# Environment mode (REQUIRED for test environment)
# Must be set to "test" for test runners to work correctly
NODE_ENV=test

# Test database (separate from development database)
# Points to test.db to prevent test data from polluting dev.db
# Automatically cleaned between test runs
DATABASE_URL="file:./test.db"

# Test session secret (valid 32+ character value for JWT signing)
# Functional for tests - does not need to be cryptographically strong
SESSION_SECRET="test-secret-key-for-jwt-signing-min-32-chars"

# Upstash Redis credentials (NOT USED by tests - mocked instead)
# Tests mock rate limiting via __tests__/helpers/ratelimit-mocks.ts
# These placeholder values are never actually called during test execution
# Real Upstash credentials are NOT needed for running tests
UPSTASH_REDIS_REST_URL="test-upstash-url-not-used-mocked"
UPSTASH_REDIS_REST_TOKEN="test-upstash-token-not-used-mocked"
