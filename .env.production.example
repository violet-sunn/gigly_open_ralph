# Production environment variables — set these in Amvera:
#   Проект -> Настройки -> Переменные окружения.
# Do NOT commit real values. NODE_ENV=production is already baked into the Docker image.

# SQLite database on the persistent volume (persistenceMount: /data in amvera.yml).
DATABASE_URL=file:/data/prod.db

# Session/JWT signing secret — REQUIRED, security-critical. Mark it as a secret in Amvera.
# Generate a strong value, e.g.:  openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
