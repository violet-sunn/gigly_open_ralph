# ============================================
# SECURITY WARNING - READ BEFORE USING
# ============================================
#
# This file contains example environment variables for development.
# NEVER commit real secrets or credentials to version control.
#
# Setup Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace all placeholder values with real values
# 3. The .env file is gitignored and safe for local secrets
#
# Important Notes:
# - Use DIFFERENT secrets for development and production
# - NEVER use placeholder values in production
# - Standard Next.js convention: .env.local for local overrides, .env for shared defaults
# - This project gitignores .env (valid alternative approach for security)
# - Both approaches are acceptable; we prioritize keeping all secrets out of version control
#
# ============================================


# ============================================
# Database Configuration
# ============================================
# Prisma database connection string
# Used in: lib/prisma.ts (line 9)
# Status: OPTIONAL (has fallback)
# Fallback: 'file:./prisma/dev.db' if not set
#
# Current value creates a local SQLite database at ./prisma/dev.db
# The file is created automatically on first migration (npx prisma migrate dev)
#
# For production, consider PostgreSQL or MySQL:
# Example PostgreSQL: postgresql://user:password@localhost:5432/dbname
DATABASE_URL="file:./prisma/dev.db"


# ============================================
# Authentication & Security
# ============================================
# Secret key for signing JWT tokens (user sessions)
# Used in: lib/session.ts (line 4), middleware.ts
# Status: REQUIRED (NO fallback - app will crash if missing)
#
# Security Requirements:
# - Must be random and unpredictable
# - Minimum 32+ characters recommended
# - Use DIFFERENT secrets for development and production
# - Changing this secret invalidates all existing user sessions
#
# Generate a secure secret using ONE of these LOCAL methods:
# (NEVER use online tools - they may log your secrets!)
#
# Method 1 - OpenSSL:
#   openssl rand -base64 32
#
# Method 2 - Node.js:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# WARNING: NEVER use this placeholder value in production!
SESSION_SECRET="your_session_secret_here"


# ============================================
# Environment Configuration
# ============================================
# NODE_ENV controls environment-specific behavior
# Used in: lib/session.ts (line 17), lib/prisma.ts (line 16)
# Status: OPTIONAL (Next.js automatically sets this in most cases)
#
# Valid values:
# - "development" - Cookies work over HTTP, Prisma connection pooling disabled
# - "production"  - Cookies require HTTPS, Prisma connection pooling enabled
# - "test"        - Used by test runners (set in .env.test)
#
# Impact on security:
# - In production: secure flag enabled (HTTPS-only cookies)
# - In development: secure flag disabled (allows HTTP for local development)
#
# Note: Next.js automatically sets NODE_ENV based on the command:
# - npm run dev → "development"
# - npm run build → "production"
# - npm test → "test"
# Manual setting is rarely needed.
